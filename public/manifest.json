{
  "manifest_version": 3,
  "name": "Capability Discovery Assistant",
  "description": "本地采集企业系统页面证据，导出可回溯的能力地图基础数据。",
  "version": "0.1.0",
  "action": {
    "default_title": "系统能力发现助手"
  },
  "side_panel": {
    "default_path": "src/popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "downloads", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
